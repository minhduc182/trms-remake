{
  "name": "trms-remake",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "vitest run",
    "test:api": "vitest run tests/acceptance/api",
    "test:e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm test:api",
    "db:generate": "pnpm --filter @trms/api db:generate",
    "db:push": "pnpm --filter @trms/api db:push",
    "db:seed": "pnpm --filter @trms/api db:seed",
    "data:extract": "tsx migration/extract/extract-from-oracle.ts",
    "data:reconcile": "tsx migration/reconcile/reconcile-costs.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@playwright/test": "^1.49.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "oracledb",
      "prisma"
    ]
  }
}
