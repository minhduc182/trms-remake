{
  "name": "@trms/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --accept-data-loss",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.2",
    "@pothos/core": "^4.3.0",
    "@pothos/plugin-prisma": "^4.4.0",
    "@pothos/plugin-relay": "^4.3.0",
    "@pothos/plugin-scope-auth": "^4.1.2",
    "@pothos/plugin-zod": "^4.1.2",
    "@prisma/client": "^6.1.0",
    "@trms/domain": "workspace:*",
    "@trms/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "fastify": "^5.1.0",
    "graphql": "^16.9.0",
    "graphql-scalars": "^1.24.0",
    "graphql-yoga": "^5.10.4",
    "nodemailer": "^6.9.16",
    "oracledb": "^6.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
