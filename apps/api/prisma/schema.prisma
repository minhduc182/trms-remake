datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

generator pothos {
  provider = "prisma-pothos-types"
}

// ============================================================================
// 1. PLATFORM CORE (GA_CORE) & SETTINGS
// ============================================================================

model System {
  id          BigInt    @id @map("system_id")
  code        String    @unique
  name        String
  description String?
  createdAt   DateTime? @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  roles       Role[]
  features    Feature[]

  @@map("systems")
}

model OrgUnit {
  id          BigInt                @id @map("unit_id")
  unitCode    String                @map("unit_code")
  name        String
  parentId    BigInt?               @map("parent_id")
  unitType    String?               @map("unit_type")
  description String?
  syncState   String?               @map("sync_state")
  delFlag     Int                   @default(0) @map("del_flag")
  createdAt   DateTime?             @default(now()) @map("created_at")
  updatedAt   DateTime?             @updatedAt @map("updated_at")
  employees   Employee[]
  userUnits   UserOrgUnitPosition[]

  @@map("org_units")
}

model User {
  id           BigInt                @id @map("user_id")
  username     String                @unique
  fullName     String                @map("full_name")
  email        String?
  phone        String?
  passwordHash String?               @map("password_hash")
  status       String                @default("ACTIVE")
  avatarPath   String?               @map("avatar_path")
  createdAt    DateTime?             @default(now()) @map("created_at")
  updatedAt    DateTime?             @updatedAt @map("updated_at")
  deletedAt    DateTime?             @map("deleted_at")
  userRoles    UserRole[]
  userUnits    UserOrgUnitPosition[]
  drivers      Driver[]

  @@map("users")
}

model Employee {
  id                BigInt                     @id @map("employee_id")
  empCode           String                     @unique @map("emp_code")
  fullName          String                     @map("full_name")
  orgUnitId         BigInt?                    @map("org_unit_id")
  positionId        BigInt?                    @map("position_id")
  activeFlag        String                     @default("Y") @map("active_flag")
  leaveDate         DateTime?                  @map("leave_date")
  createDate        DateTime?                  @default(now()) @map("create_date")
  editDate          DateTime?                  @updatedAt @map("edit_date")
  orgUnit           OrgUnit?                   @relation(fields: [orgUnitId], references: [id])
  transportProfiles EmployeeTransportProfile[]

  @@map("employees")
}

model UserOrgUnitPosition {
  userId     BigInt    @map("user_id")
  unitId     BigInt    @map("unit_id")
  positionId BigInt    @default(0) @map("position_id")
  isPrimary  String?   @default("Y") @map("is_primary")
  assignedAt DateTime? @default(now()) @map("assigned_at")
  assignedBy BigInt?   @map("assigned_by")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgUnit    OrgUnit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([userId, unitId, positionId])
  @@map("user_org_units_positions")
}

model Role {
  id            BigInt        @id @map("role_id")
  code          String        @unique
  name          String
  description   String?
  systemId      BigInt?       @map("system_id")
  isSystemAdmin Int           @default(0) @map("is_system_admin")
  system        System?       @relation(fields: [systemId], references: [id])
  userRoles     UserRole[]
  roleFeatures  RoleFeature[]

  @@map("roles")
}

model Feature {
  id           BigInt        @id @map("feature_id")
  systemId     BigInt?       @map("system_id")
  code         String        @unique
  name         String
  description  String?
  createdAt    DateTime?     @default(now()) @map("created_at")
  updatedAt    DateTime?     @updatedAt @map("updated_at")
  system       System?       @relation(fields: [systemId], references: [id])
  roleFeatures RoleFeature[]

  @@map("features")
}

model UserRole {
  userId BigInt @map("user_id")
  roleId BigInt @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RoleFeature {
  roleId    BigInt    @map("role_id")
  featureId BigInt    @map("feature_id")
  createdAt DateTime? @default(now()) @map("created_at")
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  feature   Feature   @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([roleId, featureId])
  @@map("role_features")
}

model Setting {
  id         BigInt    @id
  varKey     String    @unique @map("var_key")
  varValue   String?   @map("var_value")
  systemId   BigInt?   @map("system_id")
  createDate DateTime? @default(now()) @map("create_date")
  editDate   DateTime? @updatedAt @map("edit_date")

  @@map("settings")
}

model Shift {
  id            BigInt         @id @map("shift_id")
  shiftCode     String         @map("shift_code")
  shiftName     String         @map("shift_name")
  startTime     String?        @map("start_time")
  endTime       String?        @map("end_time")
  workHours     Decimal?       @map("work_hours") @db.Decimal(10, 2)
  activeFlag    String         @default("Y") @map("active_flag")
  delFlag       Int            @default(0) @map("del_flag")
  masterFlag    String         @default("Y") @map("master_flag")
  transportFlag String         @default("N") @map("transport_flag")
  createDate    DateTime?      @default(now()) @map("create_date")
  editDate      DateTime?      @updatedAt @map("edit_date")
  segmentShifts SegmentShift[]

  @@map("shifts")
}

// ============================================================================
// 2. TRMS MASTER DATA (TRMS_CORE)
// ============================================================================

model Vendor {
  id          BigInt    @id
  vendorCode  String    @unique @map("vendor_code")
  vendorName  String    @map("vendor_name")
  vendorType  String?   @map("vendor_type")
  contactName String?   @map("contact_name")
  phone       String?
  email       String?
  activeFlag  String    @default("Y") @map("active_flag")
  delFlag     String    @default("N") @map("del_flag")
  createDate  DateTime? @default(now()) @map("create_date")
  editDate    DateTime? @updatedAt @map("edit_date")
  vehicles    Vehicle[]
  drivers     Driver[]
  routes      Route[]

  @@map("trms_vendors")
}

model Point {
  id            BigInt                     @id
  pointCode     String                     @map("point_code")
  pointName     String                     @map("point_name")
  pointType     String                     @map("point_type") // PICKUP | DROPOFF | BOTH
  districtName  String?                    @map("district_name")
  address       String?
  isFactory     String                     @default("N") @map("is_factory")
  activeFlag    String                     @default("Y") @map("active_flag")
  delFlag       String                     @default("N") @map("del_flag")
  createDate    DateTime?                  @default(now()) @map("create_date")
  editDate      DateTime?                  @updatedAt @map("edit_date")
  segmentPoints SegmentPoint[]
  etpPickups    EmployeeTransportProfile[] @relation("EtpPickupPoint")
  etpDropoffs   EmployeeTransportProfile[] @relation("EtpDropoffPoint")

  @@map("trms_points")
}

model Vehicle {
  id                 BigInt         @id
  vehicleCode        String?        @map("vehicle_code")
  vehiclePlate       String         @map("vehicle_plate")
  vendorId           BigInt?        @map("vendor_id")
  vehicleType        String         @map("vehicle_type")
  seatCapacity       Int            @map("seat_capacity")
  ownershipType      String         @default("RENTAL") @map("ownership_type")
  commutePackageMode String?        @map("commute_package_mode")
  dailyTripQuota     Int?           @map("daily_trip_quota")
  monthlyKmQuota     Decimal?       @map("monthly_km_quota") @db.Decimal(12, 2)
  defaultDriverId    BigInt?        @map("default_driver_id")
  activeFlag         String         @default("Y") @map("active_flag")
  delFlag            String         @default("N") @map("del_flag")
  createDate         DateTime?      @default(now()) @map("create_date")
  editDate           DateTime?      @updatedAt @map("edit_date")
  vendor             Vendor?        @relation(fields: [vendorId], references: [id])
  routeVehicles      RouteVehicle[]
  segments           RouteSegment[]
  trips              Trip[]
  vehicleStatus      VehicleStatus?

  @@map("trms_vehicles")
}

model Driver {
  id             BigInt         @id
  driverName     String         @map("driver_name")
  vendorId       BigInt?        @map("vendor_id")
  phoneNumber    String         @map("phone_number")
  shortAddress   String?        @map("short_address")
  fullAddress    String?        @map("full_address")
  identityUserId BigInt?        @map("identity_user_id")
  activeFlag     String         @default("Y") @map("active_flag")
  delFlag        String         @default("N") @map("del_flag")
  createDate     DateTime?      @default(now()) @map("create_date")
  editDate       DateTime?      @updatedAt @map("edit_date")
  vendor         Vendor?        @relation(fields: [vendorId], references: [id])
  user           User?          @relation(fields: [identityUserId], references: [id])
  routeVehicles  RouteVehicle[]
  segments       RouteSegment[]
  trips          Trip[]

  @@map("trms_drivers")
}

model LegDefinition {
  id            BigInt         @id
  legCode       String         @map("leg_code")
  legName       String         @map("leg_name")
  passengerType String         @map("passenger_type") // STAFF | WORKER
  displayOrder  Int            @default(1) @map("display_order")
  direction     String         @default("TO_FACTORY") // TO_FACTORY | FROM_FACTORY
  isDeadhead    String         @default("N") @map("is_deadhead")
  activeFlag    String         @default("Y") @map("active_flag")
  delFlag       String         @default("N") @map("del_flag")
  createDate    DateTime?      @default(now()) @map("create_date")
  editDate      DateTime?      @updatedAt @map("edit_date")
  segments      RouteSegment[]

  @@map("trms_leg_definitions")
}

model Route {
  id                BigInt                     @id
  routeCode         String                     @map("route_code")
  routeName         String                     @map("route_name")
  defaultVendorId   BigInt?                    @map("default_vendor_id")
  routeClass        String                     @default("FIXED_ROUTE") @map("route_class")
  passengerType     String                     @default("STAFF") @map("passenger_type")
  runDays           String                     @default("MON_SAT") @map("run_days")
  activeFlag        String                     @default("Y") @map("active_flag")
  delFlag           String                     @default("N") @map("del_flag")
  createDate        DateTime?                  @default(now()) @map("create_date")
  editDate          DateTime?                  @updatedAt @map("edit_date")
  vendor            Vendor?                    @relation(fields: [defaultVendorId], references: [id])
  segments          RouteSegment[]
  routeVehicles     RouteVehicle[]
  transportProfiles EmployeeTransportProfile[]
  trips             Trip[]

  @@map("trms_routes")
}

model RouteSegment {
  id               BigInt         @id
  routeId          BigInt         @map("route_id")
  legDefinitionId  BigInt?        @map("leg_definition_id")
  legCode          String         @map("leg_code")
  legName          String?        @map("leg_name")
  direction        String         @default("TO_FACTORY")
  departureTime    String?        @map("departure_time")
  arrivalTime      String?        @map("arrival_time")
  defaultVehicleId BigInt?        @map("default_vehicle_id")
  defaultDriverId  BigInt?        @map("default_driver_id")
  sequenceOrder    Int            @default(1) @map("sequence_order")
  activeFlag       String         @default("Y") @map("active_flag")
  delFlag          String         @default("N") @map("del_flag")
  createDate       DateTime?      @default(now()) @map("create_date")
  editDate         DateTime?      @updatedAt @map("edit_date")
  route            Route          @relation(fields: [routeId], references: [id], onDelete: Cascade)
  legDefinition    LegDefinition? @relation(fields: [legDefinitionId], references: [id])
  defaultVehicle   Vehicle?       @relation(fields: [defaultVehicleId], references: [id])
  defaultDriver    Driver?        @relation(fields: [defaultDriverId], references: [id])
  segmentPoints    SegmentPoint[]
  segmentShifts    SegmentShift[]

  @@map("trms_route_segments")
}

model SegmentPoint {
  id          BigInt       @id
  segmentId   BigInt       @map("segment_id")
  pointId     BigInt       @map("point_id")
  pointRole   String       @default("PICKUP") @map("point_role") // PICKUP | DROPOFF
  stopOrder   Int          @default(1) @map("stop_order")
  plannedTime String?      @map("planned_time")
  createDate  DateTime?    @default(now()) @map("create_date")
  editDate    DateTime?    @updatedAt @map("edit_date")
  segment     RouteSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  point       Point        @relation(fields: [pointId], references: [id])

  @@map("trms_segment_points")
}

model SegmentShift {
  id         BigInt       @id
  segmentId  BigInt       @map("segment_id")
  shiftId    BigInt       @map("shift_id")
  createDate DateTime?    @default(now()) @map("create_date")
  editDate   DateTime?    @updatedAt @map("edit_date")
  segment    RouteSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  shift      Shift        @relation(fields: [shiftId], references: [id])

  @@map("trms_segment_shifts")
}

model RouteVehicle {
  id           BigInt    @id
  routeId      BigInt    @map("route_id")
  vehicleId    BigInt    @map("vehicle_id")
  driverId     BigInt?   @map("driver_id")
  displayOrder Int       @default(1) @map("display_order")
  activeFlag   String    @default("Y") @map("active_flag")
  delFlag      String    @default("N") @map("del_flag")
  createDate   DateTime? @default(now()) @map("create_date")
  editDate     DateTime? @updatedAt @map("edit_date")
  route        Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicle      Vehicle   @relation(fields: [vehicleId], references: [id])
  driver       Driver?   @relation(fields: [driverId], references: [id])

  @@map("trms_route_vehicles")
}

model EmployeeTransportProfile {
  id              BigInt    @id
  employeeId      BigInt?   @map("employee_id")
  routeId         BigInt    @map("route_id")
  pickupPointId   BigInt    @map("pickup_point_id")
  dropoffPointId  BigInt?   @map("dropoff_point_id")
  effectiveFrom   String    @map("effective_from")
  effectiveTo     String?   @map("effective_to")
  activeFlag      String    @default("Y") @map("active_flag")
  delFlag         String    @default("N") @map("del_flag")
  approvalStatus  String    @default("APPROVED") @map("approval_status") // PENDING | APPROVED | REJECTED
  rejectReason    String?   @map("reject_reason")
  leaveDate       String?   @map("leave_date")
  endReasonCode   String?   @map("end_reason_code")
  isProvisional   String    @default("N") @map("is_provisional")
  provTempCode    String?   @map("prov_temp_code")
  provFullName    String?   @map("prov_full_name")
  provOrgUnitId   BigInt?   @map("prov_org_unit_id")
  provShiftId     BigInt?   @map("prov_shift_id")
  provWorkDayMask String?   @map("prov_work_day_mask")
  createDate      DateTime? @default(now()) @map("create_date")
  editDate        DateTime? @updatedAt @map("edit_date")
  employee        Employee? @relation(fields: [employeeId], references: [id])
  route           Route     @relation(fields: [routeId], references: [id])
  pickupPoint     Point     @relation("EtpPickupPoint", fields: [pickupPointId], references: [id])
  dropoffPoint    Point?    @relation("EtpDropoffPoint", fields: [dropoffPointId], references: [id])

  @@map("trms_employee_transport_profiles")
}

model CostConfig {
  id            BigInt           @id
  versionCode   String           @map("version_code")
  configType    String           @map("config_type") // COMMUTE | EXTRA
  passengerType String           @map("passenger_type") // STAFF | WORKER
  vehicleType   String           @map("vehicle_type")
  pricingScope  String?          @map("pricing_scope")
  currencyCode  String           @default("VND") @map("currency_code")
  effectiveFrom String           @map("effective_from")
  effectiveTo   String?          @map("effective_to")
  activeFlag    String           @default("Y") @map("active_flag")
  delFlag       String           @default("N") @map("del_flag")
  createBy      BigInt?          @map("create_by")
  editBy        BigInt?          @map("edit_by")
  createDate    DateTime?        @default(now()) @map("create_date")
  editDate      DateTime?        @updatedAt @map("edit_date")
  rules         CostConfigRule[]

  @@map("trms_cost_configs")
}

model CostConfigRule {
  id                       BigInt     @id
  costConfigId             BigInt     @map("cost_config_id")
  ruleCode                 String     @map("rule_code")
  rateType                 String     @map("rate_type")
  dayType                  String?    @map("day_type")
  minDistanceKm            Decimal?   @map("min_distance_km") @db.Decimal(12, 2)
  maxDistanceKm            Decimal?   @map("max_distance_km") @db.Decimal(12, 2)
  minDistanceInclusiveFlag String?    @default("Y") @map("min_distance_inclusive_flag")
  maxDistanceInclusiveFlag String?    @default("Y") @map("max_distance_inclusive_flag")
  dailyTripCount           Int?       @map("daily_trip_count")
  includedDistanceKm       Decimal?   @map("included_distance_km") @db.Decimal(12, 2)
  unitPrice                Decimal    @map("unit_price") @db.Decimal(18, 2)
  priceUnit                String     @map("price_unit")
  stackableFlag            String     @default("N") @map("stackable_flag")
  priority                 Int        @default(1)
  description              String?
  activeFlag               String     @default("Y") @map("active_flag")
  delFlag                  String     @default("N") @map("del_flag")
  createDate               DateTime?  @default(now()) @map("create_date")
  editDate                 DateTime?  @updatedAt @map("edit_date")
  costConfig               CostConfig @relation(fields: [costConfigId], references: [id], onDelete: Cascade)

  @@map("trms_cost_config_rules")
}

// ============================================================================
// 3. TRMS OPERATIONS & COST (TRMS_DATA)
// ============================================================================

model ImportBatch {
  id           BigInt           @id
  batchCode    String           @map("batch_code")
  importType   String           @map("import_type")
  businessDate String?          @map("business_date")
  status       String           @default("CONFIRMED")
  totalRows    Int              @default(0) @map("total_rows")
  validRows    Int              @default(0) @map("valid_rows")
  invalidRows  Int              @default(0) @map("invalid_rows")
  createDate   DateTime?        @default(now()) @map("create_date")
  editDate     DateTime?        @updatedAt @map("edit_date")
  rows         ImportBatchRow[]

  @@map("trms_import_batches")
}

model ImportBatchRow {
  id             BigInt      @id
  batchId        BigInt      @map("batch_id")
  lineNo         Int         @map("line_no")
  rowStatus      String      @default("VALID") @map("row_status")
  employeeId     String?     @map("employee_id")
  assignmentDate String?     @map("assignment_date")
  shiftCode      String?     @map("shift_code")
  rawPayload     String?     @map("raw_payload")
  createDate     DateTime?   @default(now()) @map("create_date")
  editDate       DateTime?   @updatedAt @map("edit_date")
  batch          ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@map("trms_import_batch_rows")
}

model TransportRequest {
  id                        BigInt                 @id
  requestCode               String                 @map("request_code")
  businessDate              String                 @map("business_date")
  requestType               String                 @map("request_type") // BUSINESS | OVERTIME | GOODS | SPECIAL
  requestSource             String                 @default("MANUAL") @map("request_source")
  requesterId               BigInt?                @map("requester_id")
  requesterName             String?                @map("requester_name")
  departmentId              BigInt?                @map("department_id")
  departmentName            String?                @map("department_name")
  routeId                   BigInt?                @map("route_id")
  requestedVehicleType      String?                @map("requested_vehicle_type")
  passengerCount            Int                    @default(1) @map("passenger_count")
  status                    String                 @default("PENDING_DEPARTMENT")
  outboundStatus            String?                @map("outbound_status")
  returnStatus              String?                @map("return_status")
  returnedFromStatus        String?                @map("returned_from_status")
  approvalBypassFlag        String                 @default("N") @map("approval_bypass_flag")
  currentTripId             BigInt?                @map("current_trip_id")
  overrideReason            String?                @map("override_reason")
  tripMode                  String                 @default("ONE_WAY") @map("trip_mode") // ONE_WAY | ROUND_TRIP
  departureTime             String?                @map("departure_time")
  expectedArrivalTime       String?                @map("expected_arrival_time")
  returnTime                String?                @map("return_time")
  returnExpectedArrivalTime String?                @map("return_expected_arrival_time")
  departurePickupPointId    BigInt?                @map("departure_pickup_point_id")
  departureDropoffPointId   BigInt?                @map("departure_dropoff_point_id")
  returnPickupPointId       BigInt?                @map("return_pickup_point_id")
  returnDropoffPointId      BigInt?                @map("return_dropoff_point_id")
  departurePickupPointText  String?                @map("departure_pickup_point_text")
  departureDropoffPointText String?                @map("departure_dropoff_point_text")
  returnPickupPointText     String?                @map("return_pickup_point_text")
  returnDropoffPointText    String?                @map("return_dropoff_point_text")
  departurePointNote        String?                @map("departure_point_note")
  returnPointNote           String?                @map("return_point_note")
  contactName               String?                @map("contact_name")
  contactPhone              String?                @map("contact_phone")
  departmentApproverIds     String?                @map("department_approver_ids")
  otShiftCode               String?                @map("ot_shift_code")
  otShiftDate               String?                @map("ot_shift_date")
  otPairId                  BigInt?                @map("ot_pair_id")
  legDirection              String?                @map("leg_direction")
  pickupScope               String?                @map("pickup_scope")
  senderInfo                String?                @map("sender_info")
  receiverInfo              String?                @map("receiver_info")
  purpose                   String?
  notes                     String?
  gaActions                 String?                @map("ga_actions")
  createDate                DateTime?              @default(now()) @map("create_date")
  editDate                  DateTime?              @updatedAt @map("edit_date")
  passengers                RequestPassenger[]
  statusHistory             RequestStatusHistory[]
  approvals                 ApprovalRecord[]
  tripLinks                 TripRequestLink[]

  @@map("trms_transport_requests")
}

model RequestPassenger {
  id                        BigInt           @id
  requestId                 BigInt           @map("request_id")
  passengerId               String?          @map("passenger_id")
  passengerName             String           @map("passenger_name")
  passengerType             String           @default("STAFF") @map("passenger_type")
  departurePickupTime       String?          @map("departure_pickup_time")
  departurePickupPointText  String?          @map("departure_pickup_point_text")
  departureArrivalTime      String?          @map("departure_arrival_time")
  departureDropoffPointText String?          @map("departure_dropoff_point_text")
  returnPickupTime          String?          @map("return_pickup_time")
  returnPickupPointText     String?          @map("return_pickup_point_text")
  returnDropoffPointText    String?          @map("return_dropoff_point_text")
  passengerNote             String?          @map("passenger_note")
  createDate                DateTime?        @default(now()) @map("create_date")
  editDate                  DateTime?        @updatedAt @map("edit_date")
  request                   TransportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("trms_request_passengers")
}

model RequestStatusHistory {
  id           BigInt           @id
  requestId    BigInt           @map("request_id")
  fromStatus   String?          @map("from_status")
  toStatus     String           @map("to_status")
  actionBy     BigInt?          @map("action_by")
  actionAt     DateTime?        @default(now()) @map("action_at")
  actionReason String?          @map("action_reason")
  createDate   DateTime?        @default(now()) @map("create_date")
  editDate     DateTime?        @updatedAt @map("edit_date")
  request      TransportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("trms_request_status_history")
}

model ApprovalRecord {
  id             BigInt           @id
  requestId      BigInt           @map("request_id")
  stepNo         Int              @default(1) @map("step_no")
  approvalStage  String           @map("approval_stage")
  approverId     BigInt?          @map("approver_id")
  approverName   String?          @map("approver_name")
  decision       String // APPROVED | REJECTED | RETURNED
  decisionReason String?          @map("decision_reason")
  decidedAt      DateTime?        @default(now()) @map("decided_at")
  createDate     DateTime?        @default(now()) @map("create_date")
  editDate       DateTime?        @updatedAt @map("edit_date")
  request        TransportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("trms_approval_records")
}

model DailyPlan {
  id               BigInt        @id
  businessDate     String        @unique @map("business_date")
  status           String        @default("CURRENT")
  currentVersionId BigInt?       @map("current_version_id")
  lastBatchId      BigInt?       @map("last_batch_id")
  createDate       DateTime?     @default(now()) @map("create_date")
  editDate         DateTime?     @updatedAt @map("edit_date")
  versions         PlanVersion[]

  @@map("trms_daily_plans")
}

model PlanVersion {
  id            BigInt           @id
  planId        BigInt           @map("plan_id")
  versionNo     Int              @default(1) @map("version_no")
  sourceBatchId BigInt?          @map("source_batch_id")
  status        String           @default("CURRENT")
  currentFlag   String           @default("Y") @map("current_flag")
  publishedBy   BigInt?          @map("published_by")
  publishedAt   DateTime?        @map("published_at")
  createDate    DateTime?        @default(now()) @map("create_date")
  editDate      DateTime?        @updatedAt @map("edit_date")
  plan          DailyPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  assignments   PlanAssignment[]

  @@map("trms_plan_versions")
}

model PlanAssignment {
  id              BigInt      @id
  planVersionId   BigInt      @map("plan_version_id")
  routeId         BigInt      @map("route_id")
  segmentId       BigInt?     @map("segment_id")
  legDefinitionId BigInt?     @map("leg_definition_id")
  legCode         String      @map("leg_code")
  legName         String?     @map("leg_name")
  direction       String?
  passengerType   String?     @map("passenger_type")
  routeCode       String?     @map("route_code")
  routeName       String?     @map("route_name")
  vehicleId       BigInt?     @map("vehicle_id")
  driverId        BigInt?     @map("driver_id")
  assignmentType  String      @default("BASE") @map("assignment_type")
  demandCount     Int         @default(0) @map("demand_count")
  activeFlag      String      @default("Y") @map("active_flag")
  createDate      DateTime?   @default(now()) @map("create_date")
  editDate        DateTime?   @updatedAt @map("edit_date")
  planVersion     PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)

  @@map("trms_plan_assignments")
}

model Trip {
  id                        BigInt              @id
  tripCode                  String              @map("trip_code")
  businessDate              String              @map("business_date")
  planVersionId             BigInt?             @map("plan_version_id")
  planAssignmentId          BigInt?             @map("plan_assignment_id")
  tripType                  String              @default("SPECIAL") @map("trip_type")
  dispatchType              String              @default("DISPATCH") @map("dispatch_type")
  dispatchSource            String?             @map("dispatch_source")
  status                    String              @default("DISPATCHED")
  vendorId                  BigInt?             @map("vendor_id")
  routeId                   BigInt?             @map("route_id")
  segmentId                 BigInt?             @map("segment_id")
  legCode                   String?             @map("leg_code")
  shiftId                   BigInt?             @map("shift_id")
  vehicleId                 BigInt?             @map("vehicle_id")
  driverId                  BigInt?             @map("driver_id")
  vehiclePlateSnapshot      String?             @map("vehicle_plate_snapshot")
  driverNameSnapshot        String?             @map("driver_name_snapshot")
  driverPhoneSnapshot       String?             @map("driver_phone_snapshot")
  seatCapacitySnapshot      Int?                @map("seat_capacity_snapshot")
  plannedDepartureAt        DateTime?           @map("planned_departure_at")
  plannedArrivalAt          DateTime?           @map("planned_arrival_at")
  passengerCount            Int                 @default(0) @map("passenger_count")
  passengerType             String?             @map("passenger_type")
  tripMode                  String              @default("ONE_WAY") @map("trip_mode")
  tripLeg                   String?             @map("trip_leg")
  pairedTripId              BigInt?             @map("paired_trip_id")
  departurePickupPointId    BigInt?             @map("departure_pickup_point_id")
  departureDropoffPointId   BigInt?             @map("departure_dropoff_point_id")
  returnPickupPointId       BigInt?             @map("return_pickup_point_id")
  returnDropoffPointId      BigInt?             @map("return_dropoff_point_id")
  departurePickupPointText  String?             @map("departure_pickup_point_text")
  departureDropoffPointText String?             @map("departure_dropoff_point_text")
  returnPickupPointText     String?             @map("return_pickup_point_text")
  returnDropoffPointText    String?             @map("return_dropoff_point_text")
  deadheadKind              String?             @map("deadhead_kind")
  deadheadSourceTripId      BigInt?             @map("deadhead_source_trip_id")
  pricingScope              String?             @map("pricing_scope")
  pricingConfigId           BigInt?             @map("pricing_config_id")
  overrideReason            String?             @map("override_reason")
  notes                     String?
  delFlag                   String              @default("N") @map("del_flag")
  createDate                DateTime?           @default(now()) @map("create_date")
  editDate                  DateTime?           @updatedAt @map("edit_date")
  route                     Route?              @relation(fields: [routeId], references: [id])
  vehicle                   Vehicle?            @relation(fields: [vehicleId], references: [id])
  driver                    Driver?             @relation(fields: [driverId], references: [id])
  requestLinks              TripRequestLink[]
  executionFacts            TripExecutionFact[]
  costRecords               CostRecord[]

  @@map("trms_trips")
}

model TripRequestLink {
  id           BigInt           @id
  tripId       BigInt           @map("trip_id")
  requestId    BigInt           @map("request_id")
  linkRole     String           @default("PRIMARY") @map("link_role")
  requestLeg   String?          @default("OUTBOUND") @map("request_leg")
  splitGroupNo Int?             @default(1) @map("split_group_no")
  delFlag      String           @default("N") @map("del_flag")
  createDate   DateTime?        @default(now()) @map("create_date")
  editDate     DateTime?        @updatedAt @map("edit_date")
  trip         Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  request      TransportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("trms_trip_request_links")
}

model TripExecutionFact {
  id                   BigInt    @id
  tripId               BigInt    @map("trip_id")
  actualDepartureAt    DateTime? @map("actual_departure_at")
  actualArrivalAt      DateTime? @map("actual_arrival_at")
  actualKm             Decimal?  @map("actual_km") @db.Decimal(12, 2)
  startOdometerKm      Decimal?  @map("start_odometer_km") @db.Decimal(12, 2)
  endOdometerKm        Decimal?  @map("end_odometer_km") @db.Decimal(12, 2)
  otHours              Decimal?  @map("ot_hours") @db.Decimal(10, 2)
  actualPassengerCount Int?      @map("actual_passenger_count")
  actualKmSource       String?   @map("actual_km_source")
  completedBy          BigInt?   @map("completed_by")
  completedAt          DateTime? @map("completed_at")
  executionNote        String?   @map("execution_note")
  createDate           DateTime? @default(now()) @map("create_date")
  editDate             DateTime? @updatedAt @map("edit_date")
  trip                 Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("trms_trip_execution_facts")
}

model VehicleStatus {
  vehicleId          BigInt    @id @map("vehicle_id")
  status             String    @default("AVAILABLE")
  segmentId          BigInt?   @map("segment_id")
  routeId            BigInt?   @map("route_id")
  currentTripId      BigInt?   @map("current_trip_id")
  plannedDepartureAt DateTime? @map("planned_departure_at")
  plannedArrivalAt   DateTime? @map("planned_arrival_at")
  lastSyncedAt       DateTime? @default(now()) @map("last_synced_at")
  createDate         DateTime? @default(now()) @map("create_date")
  editDate           DateTime? @updatedAt @map("edit_date")
  vehicle            Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("trms_vehicle_status")
}

model CostRecord {
  id               BigInt    @id
  idempotencyKey   String?   @unique @map("idempotency_key")
  costRuleId       BigInt?   @map("cost_rule_id")
  costSource       String    @default("AUTO") @map("cost_source")
  costType         String    @map("cost_type")
  costScope        String    @default("TRIP") @map("cost_scope")
  tripId           BigInt?   @map("trip_id")
  vehicleId        BigInt?   @map("vehicle_id")
  routeId          BigInt?   @map("route_id")
  serviceDate      String?   @map("service_date")
  costMonth        String?   @map("cost_month")
  quantity         Decimal   @default(1) @db.Decimal(14, 4)
  appliedUnitPrice Decimal   @default(0) @map("applied_unit_price") @db.Decimal(18, 2)
  appliedAmount    Decimal   @default(0) @map("applied_amount") @db.Decimal(18, 2)
  vatRate          Decimal   @default(0.08) @map("vat_rate") @db.Decimal(6, 4)
  vatAmount        Decimal   @default(0) @map("vat_amount") @db.Decimal(18, 2)
  amountAfterVat   Decimal   @default(0) @map("amount_after_vat") @db.Decimal(18, 2)
  description      String?
  costStatus       String    @default("DRAFT") @map("cost_status")
  pricedAt         DateTime? @default(now()) @map("priced_at")
  createDate       DateTime? @default(now()) @map("create_date")
  editDate         DateTime? @updatedAt @map("edit_date")
  trip             Trip?     @relation(fields: [tripId], references: [id])

  @@map("trms_cost_records")
}

model MonthlyPayment {
  id             BigInt              @id
  paymentMonth   String              @unique @map("payment_month")
  vendorId       BigInt?             @map("vendor_id")
  totalBeforeVat Decimal             @default(0) @map("total_before_vat") @db.Decimal(18, 2)
  totalVatAmount Decimal             @default(0) @map("total_vat_amount") @db.Decimal(18, 2)
  totalAfterVat  Decimal             @default(0) @map("total_after_vat") @db.Decimal(18, 2)
  status         String              @default("DRAFT")
  createDate     DateTime?           @default(now()) @map("create_date")
  editDate       DateTime?           @updatedAt @map("edit_date")
  details        MonthlyCostDetail[]

  @@map("trms_monthly_payments")
}

model MonthlyCostDetail {
  id                   BigInt         @id
  monthlyPaymentId     BigInt         @map("monthly_payment_id")
  lineNo               Int            @default(1) @map("line_no")
  lineType             String         @default("VEHICLE_ROUTE") @map("line_type")
  driverId             BigInt?        @map("driver_id")
  driverNameSnapshot   String?        @map("driver_name_snapshot")
  vehicleId            BigInt?        @map("vehicle_id")
  vehiclePlateSnapshot String?        @map("vehicle_plate_snapshot")
  routeId              BigInt?        @map("route_id")
  routeNameSnapshot    String?        @map("route_name_snapshot")
  tripDescription      String?        @map("trip_description")
  dailyTripCount       Int?           @map("daily_trip_count")
  basicChargeAmount    Decimal        @default(0) @map("basic_charge_amount") @db.Decimal(18, 2)
  overtimeHours        Decimal        @default(0) @map("overtime_hours") @db.Decimal(12, 4)
  overtimeUnitPrice    Decimal        @default(0) @map("overtime_unit_price") @db.Decimal(18, 2)
  overtimeAmount       Decimal        @default(0) @map("overtime_amount") @db.Decimal(18, 2)
  totalDistanceKm      Decimal        @default(0) @map("total_distance_km") @db.Decimal(12, 2)
  includedDistanceKm   Decimal        @default(0) @map("included_distance_km") @db.Decimal(12, 2)
  excessKm             Decimal        @default(0) @map("excess_km") @db.Decimal(12, 2)
  excessKmUnitPrice    Decimal        @default(0) @map("excess_km_unit_price") @db.Decimal(18, 2)
  excessKmAmount       Decimal        @default(0) @map("excess_km_amount") @db.Decimal(18, 2)
  overnightAmount      Decimal        @default(0) @map("overnight_amount") @db.Decimal(18, 2)
  tollFeeAmount        Decimal        @default(0) @map("toll_fee_amount") @db.Decimal(18, 2)
  extraTripAmount      Decimal        @default(0) @map("extra_trip_amount") @db.Decimal(18, 2)
  totalBeforeVat       Decimal        @default(0) @map("total_before_vat") @db.Decimal(18, 2)
  vatAmount            Decimal        @default(0) @map("vat_amount") @db.Decimal(18, 2)
  totalAfterVat        Decimal        @default(0) @map("total_after_vat") @db.Decimal(18, 2)
  createDate           DateTime?      @default(now()) @map("create_date")
  editDate             DateTime?      @updatedAt @map("edit_date")
  monthlyPayment       MonthlyPayment @relation(fields: [monthlyPaymentId], references: [id], onDelete: Cascade)

  @@map("trms_monthly_cost_details")
}

model AuditLog {
  id          BigInt    @id
  entityType  String    @map("entity_type")
  entityId    String    @map("entity_id")
  actionType  String    @map("action_type")
  changedBy   BigInt?   @map("changed_by")
  actorName   String?   @map("actor_name")
  changedAt   DateTime? @default(now()) @map("changed_at")
  summaryText String?   @map("summary_text")
  createDate  DateTime? @default(now()) @map("create_date")

  @@map("trms_audit_logs")
}
