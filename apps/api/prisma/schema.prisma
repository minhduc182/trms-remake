// ============================================================================
// TRMS Remake — Complete PostgreSQL Prisma Schema
// Source: Oracle TRMS_CORE, TRMS_DATA & PLATFORM_CORE (GA_CORE)
// ============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

generator pothos {
  provider = "prisma-pothos-types"
}

