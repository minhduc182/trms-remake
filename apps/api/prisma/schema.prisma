/// Source Oracle: GA_CORE.USERS (PLATFORM_CORE.USERS)
model User {
  id           BigInt    @id @map("USER_ID")
  username     String    @unique @map("USERNAME") @db.VarChar(100)
  fullName     String    @map("FULL_NAME") @db.VarChar(200)
  email        String?   @map("EMAIL") @db.VarChar(200)
  phone        String?   @map("PHONE") @db.VarChar(50)
  passwordHash String    @map("PASSWORD_HASH") @db.VarChar(255)
  status       String    @default("ACTIVE") @map("STATUS") @db.VarChar(30)
  avatarPath   String?   @map("AVATAR_PATH") @db.VarChar(500)
  createdAt    DateTime  @default(now()) @map("CREATED_AT")
  updatedAt    DateTime  @updatedAt @map("UPDATED_AT")
  deletedAt    DateTime? @map("DELETED_AT")

  // Relations
  userRoles        UserRole[]
  orgUnitPositions UserOrgUnitPosition[]
  assignedPositions UserOrgUnitPosition[] @relation("UserOrgUnitAssignedBy")
  driverProfile    Driver?               @relation("DriverIdentityUser")
  notifications    Notification[]

  @@index([status])
  @@map("users")
}

/// Source Oracle: GA_CORE.EMPLOYEES (PLATFORM_CORE.EMPLOYEES)
model Employee {
  id          BigInt    @id @map("EMPLOYEE_ID")
  empCode     String    @unique @map("EMP_CODE") @db.VarChar(50)
  fullName    String    @map("FULL_NAME") @db.VarChar(200)
  orgUnitId   BigInt?   @map("ORG_UNIT_ID")
  positionId  BigInt?   @map("POSITION_ID")
  activeFlag  String    @default("Y") @map("ACTIVE_FLAG") @db.Char(1)
  createDate  DateTime  @default(now()) @map("CREATE_DATE")
  editDate    DateTime  @updatedAt @map("EDIT_DATE")
  leaveDate   DateTime? @map("LEAVE_DATE") @db.Date

  // Relations
  orgUnit            OrgUnit?                   @relation(fields: [orgUnitId], references: [id])
  transportProfiles  EmployeeTransportProfile[]
  shiftRegistrations ShiftRegistration[]

  @@index([orgUnitId])
  @@index([activeFlag])
  @@map("employees")
}

/// Source Oracle: GA_CORE.ORG_UNITS (PLATFORM_CORE.ORG_UNITS)
model OrgUnit {
  id          BigInt   @id @map("UNIT_ID")
  unitCode    String   @unique @map("UNIT_CODE") @db.VarChar(50)
  name        String   @map("NAME") @db.VarChar(200)
  parentId    BigInt?  @map("PARENT_ID")
  unitType    String?  @map("UNIT_TYPE") @db.VarChar(50)
  description String?  @map("DESCRIPTION") @db.VarChar(500)
  syncState   String?  @map("SYNC_STATE") @db.VarChar(30)
  delFlag     Int      @default(0) @map("DEL_FLAG")
  createdAt   DateTime @default(now()) @map("CREATED_AT")
  updatedAt   DateTime @updatedAt @map("UPDATED_AT")

  // Relations
  parent                      OrgUnit?                   @relation("OrgUnitHierarchy", fields: [parentId], references: [id])
  children                    OrgUnit[]                  @relation("OrgUnitHierarchy")
  employees                   Employee[]
  userPositions               UserOrgUnitPosition[]
  provisionalTransportProfiles EmployeeTransportProfile[] @relation("ProvisionalOrgUnit")

  @@index([parentId])
  @@index([delFlag])
  @@map("org_units")
}

/// Source Oracle: GA_CORE.USER_ORG_UNITS_POSITIONS (PLATFORM_CORE.USER_ORG_UNITS_POSITIONS)
model UserOrgUnitPosition {
  id         BigInt   @id @map("ID")
  userId     BigInt   @map("USER_ID")
  unitId     BigInt   @map("UNIT_ID")
  positionId BigInt?  @map("POSITION_ID")
  isPrimary  String   @default("N") @map("IS_PRIMARY") @db.Char(1)
  assignedAt DateTime @default(now()) @map("ASSIGNED_AT")
  assignedBy BigInt?  @map("ASSIGNED_BY")

  // Relations
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgUnit        OrgUnit  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  assignedByUser User?    @relation("UserOrgUnitAssignedBy", fields: [assignedBy], references: [id])

  @@unique([userId, unitId, positionId])
  @@index([userId])
  @@index([unitId])
  @@map("user_org_units_positions")
}

